--- /dev/null
+++ b/packages/reia-events/src/index.ts
@@ -0,0 +1,24 @@
+import { z } from 'zod'
+
+export const avatarMoodSchema = z.enum(['idle', 'listening', 'thinking', 'speaking', 'error'])
+
+export const avatarCommandEventSchema = z.object({
+  type: z.enum(['avatar/state', 'avatar/speak', 'avatar/gesture']),
+  timestamp: z.string().datetime(),
+  payload: z.object({
+    mood: avatarMoodSchema.optional(),
+    text: z.string().optional(),
+    gesture: z.enum(['wave', 'nod', 'blink']).optional(),
+  }),
+})
+
+export type AvatarMood = z.infer<typeof avatarMoodSchema>
+export type AvatarCommandEvent = z.infer<typeof avatarCommandEventSchema>
+
+export function createAvatarStateEvent(mood: AvatarMood, text?: string): AvatarCommandEvent {
+  return avatarCommandEventSchema.parse({
+    type: 'avatar/state',
+    timestamp: new Date().toISOString(),
+    payload: { mood, text },
+  })
+}
