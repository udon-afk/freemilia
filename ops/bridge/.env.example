# openclaw-openai-bridge configuration

# Listener
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Modes:
# - mock: return synthetic response (default)
# - passthrough: forward to upstream /v1/chat/completions
BRIDGE_MODE=mock

# Model id returned by /v1/models and default model in /v1/chat/completions
BRIDGE_MODEL=openclaw-reia-mock

# Optional auth required by this bridge (AIRI should send this as API key)
# Leave blank to disable auth check.
BRIDGE_API_KEY=dev-openclaw-key

# Passthrough target (used only when BRIDGE_MODE=passthrough)
# Example: https://api.openai.com
BRIDGE_PASSTHROUGH_BASE_URL=
BRIDGE_PASSTHROUGH_API_KEY=
