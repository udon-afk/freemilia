# openclaw-openai-bridge configuration

# Listener
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Modes:
# - mock: return synthetic response (default)
# - passthrough: forward to upstream /v1/chat/completions
# - openclaw: forward to OpenClaw endpoint or generic webhook
BRIDGE_MODE=mock

# Model id returned by /v1/models and default model in /v1/chat/completions
BRIDGE_MODEL=openclaw-reia-mock

# Optional auth required by this bridge (AIRI should send this as API key)
# Leave blank to disable auth check.
BRIDGE_API_KEY=dev-openclaw-key

# Upstream timeout in milliseconds (passthrough/openclaw)
BRIDGE_UPSTREAM_TIMEOUT_MS=60000

# Retry policy (passthrough/openclaw)
# total attempts = 1 + BRIDGE_UPSTREAM_MAX_RETRIES
BRIDGE_UPSTREAM_MAX_RETRIES=2
BRIDGE_UPSTREAM_RETRY_BASE_DELAY_MS=300
BRIDGE_UPSTREAM_RETRY_MAX_DELAY_MS=5000

# Max request body bytes accepted by bridge
BRIDGE_MAX_BODY_BYTES=1000000

# Set false to reduce request-level logs
BRIDGE_LOG_REQUESTS=true

# Passthrough target (used only when BRIDGE_MODE=passthrough)
# Example: https://api.openai.com
BRIDGE_PASSTHROUGH_BASE_URL=
BRIDGE_PASSTHROUGH_API_KEY=

# OpenClaw backend target (used only when BRIDGE_MODE=openclaw)
# Either BRIDGE_OPENCLAW_ENDPOINT or BRIDGE_OPENCLAW_WEBHOOK_URL is required.
# Example endpoint: http://127.0.0.1:8080/v1/chat/completions
BRIDGE_OPENCLAW_ENDPOINT=
BRIDGE_OPENCLAW_WEBHOOK_URL=
BRIDGE_OPENCLAW_API_KEY=
